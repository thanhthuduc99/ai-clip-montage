# Copy file này thành .env rồi điền key.

# Bắt buộc — AI phân tích clip, viết kịch bản, chọn clip
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_KEY=

# Tùy chọn — đổi model
# VISION_MODEL=google/gemini-2.5-flash
# TEXT_MODEL=openai/gpt-4o-mini

# Giọng đọc: edge (free, mặc định, không cần key) | vivibe (trả phí)
# VOICE_PROVIDER=edge
# DEFAULT_VOICE=edge:
# API_VIVIBE_KEY=

# Render
# PORT=7799
# TRANSITION=fade
# TRANSITION_DURATION=0.4
# BGM_VOLUME=0.15
# SFX_VOLUME=0.55
# ANALYZE_FRAMES=6
